{
  "BucketName": "breach-pattern-bucket-030",
  "ARN": "arn:aws:s3:::breach-pattern-bucket-030",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "PublicFullReadWrite",
        "Effect": "Allow",
        "Principal": "*",
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject"
        ],
        "Resource": "arn:aws:s3:::breach-pattern-bucket-030/*"
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": false,
    "Rules": []
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": false,
    "IgnorePublicAcls": false,
    "BlockPublicPolicy": false,
    "RestrictPublicBuckets": false
  },
  "LoggingConfiguration": {
    "LoggingEnabled": null
  },
  "VersioningConfiguration": {
    "Status": "Suspended"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Disabled"
  }
}