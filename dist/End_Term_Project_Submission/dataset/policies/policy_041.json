{
  "BucketName": "secure-edge-case-041",
  "ARN": "arn:aws:s3:::secure-edge-case-041",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowCorpOfficeIPOnly",
        "Effect": "Allow",
        "Principal": "*",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::secure-edge-case-041/*",
        "Condition": {
          "IpAddress": {
            "aws:SourceIp": [
              "198.51.100.0/24",
              "203.0.113.50/32"
            ]
          }
        }
      },
      {
        "Sid": "EnforceTLS",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": [
          "arn:aws:s3:::secure-edge-case-041",
          "arn:aws:s3:::secure-edge-case-041/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "aws:kms"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "audit-logs-compliance-us-east-1",
      "TargetPrefix": "access-logs/secure-edge-case-041/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}