{
  "BucketName": "subtle-bypass-bucket-079",
  "ARN": "arn:aws:s3:::subtle-bypass-bucket-079",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ReadAnalyticsWildcard",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::123456789012:role/external-partner-079"
        },
        "Action": [
          "s3:Get*",
          "s3:List*"
        ],
        "Resource": "arn:aws:s3:::subtle-bypass-bucket-079/*"
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "AES256"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "audit-logs-compliance-us-east-1",
      "TargetPrefix": "access-logs/subtle-bypass-bucket-079/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}