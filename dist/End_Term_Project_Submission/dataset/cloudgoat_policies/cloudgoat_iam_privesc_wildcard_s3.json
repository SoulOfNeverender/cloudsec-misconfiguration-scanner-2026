{
  "BucketName": "cloudgoat_iam_privesc_wildcard_s3",
  "ARN": "arn:aws:s3:::cloudgoat_iam_privesc_wildcard_s3",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CloudGoatStatement",
        "Effect": "Allow",
        "Principal": "arn:aws:iam::333344445555:user/cg-dev-user",
        "Action": [
          "s3:*"
        ],
        "Resource": [
          "arn:aws:s3:::cloudgoat_iam_privesc_wildcard_s3",
          "arn:aws:s3:::cloudgoat_iam_privesc_wildcard_s3/*"
        ]
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": false,
    "Rules": []
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": false,
    "IgnorePublicAcls": false,
    "BlockPublicPolicy": false,
    "RestrictPublicBuckets": false
  },
  "LoggingConfiguration": {
    "LoggingEnabled": null
  },
  "VersioningConfiguration": {
    "Status": "Suspended"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Disabled"
  }
}