{
  "BucketName": "secure-edge-case-051",
  "ARN": "arn:aws:s3:::secure-edge-case-051",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowVpcEndpointTrafficOnly",
        "Effect": "Allow",
        "Principal": "*",
        "Action": [
          "s3:GetObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::secure-edge-case-051",
          "arn:aws:s3:::secure-edge-case-051/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:sourceVpce": "vpce-0a1b2c3d4e5f051"
          }
        }
      },
      {
        "Sid": "EnforceTLS",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": "arn:aws:s3:::secure-edge-case-051/*",
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "aws:kms"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "audit-logs-compliance-us-east-1",
      "TargetPrefix": "access-logs/secure-edge-case-051/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}