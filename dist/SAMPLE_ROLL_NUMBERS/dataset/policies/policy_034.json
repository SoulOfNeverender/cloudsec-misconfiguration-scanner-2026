{
  "BucketName": "breach-pattern-bucket-034",
  "ARN": "arn:aws:s3:::breach-pattern-bucket-034",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowAppRole",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::123456789012:role/service-034"
        },
        "Action": [
          "s3:GetObject",
          "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::breach-pattern-bucket-034/*"
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": false,
    "Rules": []
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": null
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Disabled"
  }
}