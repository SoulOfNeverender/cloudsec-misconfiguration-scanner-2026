{
  "BucketName": "cloudgoat_breach_s3_mitigated",
  "ARN": "arn:aws:s3:::cloudgoat_breach_s3_mitigated",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CloudGoatStatement",
        "Effect": "Allow",
        "Principal": "*",
        "Action": [
          "s3:GetObject"
        ],
        "Resource": [
          "arn:aws:s3:::cloudgoat_breach_s3_mitigated",
          "arn:aws:s3:::cloudgoat_breach_s3_mitigated/*"
        ],
        "Condition": {
          "StringEquals": {
            "aws:sourceVpce": [
              "vpce-cloudgoat123"
            ]
          }
        }
      },
      {
        "Sid": "EnforceTLSRequestsOnly",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": [
          "arn:aws:s3:::cloudgoat_breach_s3_mitigated",
          "arn:aws:s3:::cloudgoat_breach_s3_mitigated/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "aws:kms"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "central-compliance-logs",
      "TargetPrefix": "logs/cloudgoat_breach_s3_mitigated/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}