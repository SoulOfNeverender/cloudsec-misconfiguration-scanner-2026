{
  "BucketName": "flaws_extended_eval_case_24",
  "ARN": "arn:aws:s3:::flaws_extended_eval_case_24",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "FlawsStatement",
        "Effect": "Allow",
        "Principal": "*",
        "Action": [
          "s3:GetObject"
        ],
        "Resource": [
          "arn:aws:s3:::flaws_extended_eval_case_24",
          "arn:aws:s3:::flaws_extended_eval_case_24/*"
        ],
        "Condition": {
          "IpAddress": {
            "aws:SourceIp": [
              "10.0.24.0/24"
            ]
          }
        }
      },
      {
        "Sid": "EnforceTLSRequestsOnly",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": [
          "arn:aws:s3:::flaws_extended_eval_case_24",
          "arn:aws:s3:::flaws_extended_eval_case_24/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "aws:kms"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "central-audit-flaws",
      "TargetPrefix": "logs/flaws_extended_eval_case_24/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}