{
  "BucketName": "breach-pattern-bucket-019",
  "ARN": "arn:aws:s3:::breach-pattern-bucket-019",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "OverprivilegedRoleGrant",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::123456789012:role/app-worker-019"
        },
        "Action": "s3:*",
        "Resource": "arn:aws:s3:::breach-pattern-bucket-019/*"
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": false,
    "Rules": []
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "audit-logs-compliance-us-east-1",
      "TargetPrefix": "access-logs/breach-pattern-bucket-019/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Disabled"
  }
}