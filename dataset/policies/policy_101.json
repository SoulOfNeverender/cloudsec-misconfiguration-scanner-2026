{
  "BucketName": "production-hardened-vault-101",
  "ARN": "arn:aws:s3:::production-hardened-vault-101",
  "Policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "EnforceTLSRequestsOnly",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:*",
        "Resource": [
          "arn:aws:s3:::production-hardened-vault-101",
          "arn:aws:s3:::production-hardened-vault-101/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "false"
          }
        }
      },
      {
        "Sid": "DenyUnencryptedUploads",
        "Effect": "Deny",
        "Principal": "*",
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::production-hardened-vault-101/*",
        "Condition": {
          "StringNotEquals": {
            "s3:x-amz-server-side-encryption": [
              "aws:kms",
              "AES256"
            ]
          }
        }
      },
      {
        "Sid": "AllowAppRoleLeastPrivilege",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::123456789012:role/prod-service-role-101"
        },
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::production-hardened-vault-101",
          "arn:aws:s3:::production-hardened-vault-101/*"
        ]
      }
    ]
  },
  "ServerSideEncryptionConfiguration": {
    "Enabled": true,
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "aws:kms"
        }
      }
    ]
  },
  "PublicAccessBlockConfiguration": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "LoggingConfiguration": {
    "LoggingEnabled": {
      "TargetBucket": "audit-logs-compliance-us-east-1",
      "TargetPrefix": "access-logs/production-hardened-vault-101/"
    }
  },
  "VersioningConfiguration": {
    "Status": "Enabled"
  },
  "ObjectLockConfiguration": {
    "ObjectLockEnabled": "Enabled"
  }
}